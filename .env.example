# Copy this file to .env and add values locally. Do not commit .env.

# Summary, action-item extraction, and grounded answer generation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Audio/video recording transcription and diarization through Deepgram.
DEEPGRAM_API_KEY=
MAX_MEDIA_UPLOAD_BYTES=104857600

# Optional PostgreSQL persistence. When unset, local SQLite is persistent.
DATABASE_URL=
DATABASE_PATH=backend/data/app.db
